<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hn_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/housenail_widget_background"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="HOUSE NAIL" android:textColor="#DDBA80" android:textSize="11sp"
        android:fontFamily="serif" />
    <TextView android:id="@+id/hn_widget_count" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Lịch hôm nay"
        android:textColor="#FFF7E9" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/hn_widget_next" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#F0D3A1" android:textSize="13sp" />
    <TextView android:id="@+id/hn_widget_detail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#E9DFD0" android:textSize="11sp" />
</LinearLayout>
