<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hn_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/housenail_widget_background" android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✦ HouseNail"
        android:textColor="@color/hn_widget_ink" android:textSize="17sp" android:fontFamily="serif" android:textStyle="bold" android:maxLines="1"/>
    <TextView android:id="@+id/hn_widget_count" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:text="—" android:textColor="@color/hn_widget_ink" android:fontFamily="serif" android:textStyle="bold" android:textSize="52sp"
        android:gravity="center_vertical" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="22sp" android:autoSizeMaxTextSize="52sp" android:autoSizeStepGranularity="2sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lịch hôm nay"
        android:textColor="@color/hn_widget_gold" android:textSize="12sp" android:maxLines="1"/>
    <TextView android:id="@+id/hn_widget_next" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/hn_widget_gold" android:textSize="12sp" android:maxLines="1"/>
    <TextView android:id="@+id/hn_widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/hn_widget_gold" android:textSize="10sp" android:maxLines="2"/>
</LinearLayout>
